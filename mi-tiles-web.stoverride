name: My Tiles - ChatGPT Gemini Claude Spotify
desc: 折叠磁贴 - 检测 ChatGPT / Gemini / Claude / Spotify 解锁状态

tiles:
  - name: ChatGPT-Web-Check
    title: ChatGPT
    icon: https://fastly.jsdelivr.net/gh/StashNetworks/misc@main/collapsed-tiles/img/chatgpt.png
    collapsed: true
    url: https://chatgpt.com
  - name: Gemini-Check
    title: Gemini
    icon: https://fastly.jsdelivr.net/gh/pengyanai/misc@main/collapsed-tiles/img/gemini.png
    collapsed: true
    url: https://gemini.google.com
  - name: Claude-Check
    title: Claude
    icon: https://raw.githubusercontent.com/pengyanai/misc/refs/heads/main/collapsed-tiles/img/claude.png
    collapsed: true
    url: https://claude.ai
  - name: Spotify-Check
    title: Spotify
    icon: https://fastly.jsdelivr.net/gh/pengyanai/misc@main/collapsed-tiles/img/spotify.png
    collapsed: true
    url: https://www.spotify.com
  - name: YTMusic-Check
    title: YouTube Music
    icon: https://cdn.jsdelivr.net/gh/RiverFlowsInUUU/stash-tiles-web@main/img/ytmusic.png
    collapsed: true
    url: https://music.youtube.com
  - name: Netflix-Check
    title: Netflix
    icon: https://cdn.jsdelivr.net/gh/RiverFlowsInUUU/stash-tiles-web@main/img/netflix.png
    collapsed: true
    url: https://www.netflix.com

script-providers:
  ChatGPT-Web-Check:
    url: https://cdn.jsdelivr.net/gh/RiverFlowsInUUU/stash-tiles-web@main/script/chatgpt-web.js
    path: tiles/chatgpt-web.js
  Gemini-Check:
    url: https://cdn.jsdelivr.net/gh/RiverFlowsInUUU/stash-tiles-web@main/script/gemini-web.js
    path: tiles/gemini-web.js
  Claude-Check:
    url: https://cdn.jsdelivr.net/gh/RiverFlowsInUUU/stash-tiles-web@main/script/claude-web.js
    path: tiles/claude-web.js
  Spotify-Check:
    url: https://fastly.jsdelivr.net/gh/pengyanai/misc@main/collapsed-tiles/script/spotify.js
    path: tiles/spotify.js
  YTMusic-Check:
    url: https://cdn.jsdelivr.net/gh/RiverFlowsInUUU/stash-tiles-web@main/script/ytmusic-web.js
    path: tiles/ytmusic-web.js
  Netflix-Check:
    url: https://cdn.jsdelivr.net/gh/RiverFlowsInUUU/stash-tiles-web@main/script/netflix-web.js
    path: tiles/netflix-web.js
